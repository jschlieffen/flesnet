Screen {
    layout: vertical;
}

#toolbar {
    height: 3;
    padding: 0 1;
}

#toolbar Button {
    margin-right: 1;
}

#main {
    height: 1fr;
}

#log {
    width: 1fr;
    height: 1fr;
    border: solid green;
}

#chart {
    width: 1fr;
    height: 1fr;
    border: solid cyan;
}

#status {
    height: 1;
    padding-left: 1;
}